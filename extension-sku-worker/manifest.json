{
  "manifest_version": 3,
  "name": "Etsy SKU Worker",
  "version": "2.2.3",
  "description": "Background worker for Etsy SKU and review synchronization via Firebase.",
  "permissions": [
    "storage",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "*://*.etsy.com/*",
    "https://*/*",
    "https://*.googleapis.com/*",
    "https://*.firebaseio.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "http://localhost:3001/*",
        "https://dashboard2-alpha-bay.vercel.app/*"
      ],
      "js": [
        "sku-bridge.js"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Etsy SKU Worker Settings"
  }
}