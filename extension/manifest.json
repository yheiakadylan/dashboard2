{
    "manifest_version": 3,
    "name": "Etsy Listing Tracker",
    "version": "1.0.0",
    "description": "Track Etsy shop listings automatically from your browser",
    "key": "",
    "permissions": [
        "tabs",
        "scripting",
        "storage",
        "alarms"
    ],
    "host_permissions": [
        "https://www.etsy.com/*",
        "http://localhost:3001/*",
        "http://localhost:3000/*",
        "https://dashboardvikcom.vercel.app/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://www.etsy.com/shop/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "http://localhost:3000/*",
                "http://localhost:3001/*",
                "https://dashboardvikcom.vercel.app/*"
            ],
            "js": [
                "dashboard-bridge.js"
            ],
            "run_at": "document_start"
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icon.png",
            "48": "icon.png",
            "128": "icon.png"
        }
    },
    "icons": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "externally_connectable": {
        "matches": [
            "http://localhost:3000/*",
            "http://localhost:3001/*",
            "https://dashboardvikcom.vercel.app/*"
        ]
    }
}